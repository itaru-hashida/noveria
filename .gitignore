.venv/
.venv-native/
.venv312/
.tools/
__pycache__/
.pytest_cache/
# Временные каталоги pytest: тесты работают с настоящей LadybugDB и оставляют
# сотни мегабайт после падений.
pytest-of-*/
tmp/
.tmp*/
*.tmp
*.temp
*.py[cod]
# Локальные продукты сборки Cython.
modules/economy/native/build/
modules/economy/native/serial_step.c
modules/economy/native/*.so
modules/economy/native/*.pyd
# Бинарные профили cProfile: воспроизводятся прогоном, в репозиторий не нужны.
*.prof
audit_results/
archives/experiments/
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
